# Core
APP_ENV=development
APP_NAME=AuditReady AI
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8010
FRONTEND_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8010
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: leave blank to derive ws:// or wss:// automatically from NEXT_PUBLIC_API_BASE_URL
NEXT_PUBLIC_WS_BASE_URL=

# Security
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=postgresql+psycopg://auditready:replace-with-a-strong-db-password@127.0.0.1:5432/auditready_ai
FILE_ENCRYPTION_KEY=replace-with-a-base64-fernet-key
ENFORCE_HTTPS=false

# Bootstrap admin
ADMIN_EMAIL=admin@auditready.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_FULL_NAME=Audit Administrator

# PostgreSQL container defaults for local dev
POSTGRES_DB=auditready_ai
POSTGRES_USER=auditready
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_PORT=5432
POSTGRES_BIND_HOST=127.0.0.1

# Storage
CHROMA_DIR=backend/storage/chroma
GRAPH_STORE_PATH=data/processed/knowledge_graph.json
GRAPH_INDEX_PATH=data/processed/knowledge_graph_index.json
LIGHTRAG_WORKDIR=backend/storage/lightrag
UPLOAD_DIR=backend/uploads
REPORT_DIR=backend/reports
MAX_UPLOAD_MB=15
MAX_PROJECT_FILES=200
MAX_PROJECT_STORAGE_MB=500

# Models
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_REQUEST_TIMEOUT_SECONDS=180
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Set AI_PROVIDER=groq and provide a key to use Groq for text/structured chat.
# Vision is configured independently so Groq text can be paired with private,
# local image understanding through Ollama. Groq remains an optional fallback.
AI_PROVIDER=ollama
GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
VISION_PROVIDER=ollama
VISION_FALLBACK_PROVIDER=groq
VISION_REQUEST_TIMEOUT_SECONDS=30
VISION_MAX_IMAGES=3
RELEVANCE_EVALUATOR_TIMEOUT_SECONDS=8

# Retrieval / graph
RETRIEVAL_TOP_K=8
GRAPH_HOPS=2
MAX_RETRIES=2
USE_LIGHTRAG_CORE=true

# Optional MCP servers
ENABLE_FILESYSTEM_MCP=false
FILESYSTEM_MCP_URL=
ENABLE_GMAIL_MCP=false
ENABLE_WHATSAPP_MCP=false
GMAIL_MCP_URL=
ENABLE_WEB_SEARCH_MCP=true
WEB_SEARCH_TIMEOUT_SECONDS=5
WEB_SEARCH_MCP_URL=

# Optional MCP stdio commands
FILESYSTEM_MCP_COMMAND=
GMAIL_MCP_COMMAND=
WEB_SEARCH_MCP_COMMAND=
DOCUMENTS_MCP_COMMAND=
EMAIL_MCP_COMMAND=
UTILITIES_MCP_COMMAND=
WHATSAPP_MCP_COMMAND=
USE_DUMMY_COMMUNICATIONS=true

# DuckDuckGo remains the default. Keep its network request below the complete
# MCP deadline above so the graph can fail safely within an interactive turn.
WEB_SEARCH_HTTP_TIMEOUT_SECONDS=2.5
SEARXNG_URL=

# Local open-source email MCP (SMTP send + IMAP inbox/attachments)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Optional self-hosted SearXNG; blank uses DuckDuckGo HTML search
SEARXNG_URL=
MCP_WORKSPACE_ROOT=.
MCP_OUTPUT_DIR=backend/generated
